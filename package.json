{
  "name": "3d-bicycle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "整车从零组装 · 3D 分步交互说明书",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test tools/unit.test.mjs tools/bom.test.mjs",
    "model": "node tools/glb-tree.mjs public/models/CarbonFrameBike.glb",
    "verify": "node tools/check-manifest.mjs",
    "check:code": "npm run lint && npm test && npm run verify && npm run build",
    "smoke": "node tools/smoke.mjs",
    "shots": "node tools/shots.mjs",
    "frames": "node tools/frame-audit.mjs",
    "check": "npm run check:code && npm run smoke",
    "live": "node tools/live-check.mjs",
    "alias": "node tools/vercel-alias.mjs"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "playwright": "^1.62.1",
    "vite": "^8.2.1"
  },
  "license": "AGPL-3.0-only",
  "author": "MrBaoboer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrBaoboer/3D-Bicycle.git"
  },
  "homepage": "https://3d-bicycle.vercel.app",
  "bugs": {
    "url": "https://github.com/MrBaoboer/3D-Bicycle/issues"
  }
